{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wrist-remote-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PairRelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairRelayRoom"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
